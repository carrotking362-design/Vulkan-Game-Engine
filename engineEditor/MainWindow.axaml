<!-- Note: -->
   <!-- Why are there so many comments and they may seem very obvious? -->
      <!-- This is my first project using Avalonia properly so i want to document everything for myself -->
      <!-- so i can look back and remebmer how to do this -->
   
      <!-- If there are lots of commants referencing HTML and CSS, Thats so future me can look back and remember -->
      <!-- this easier from the HTML counter parts -->

<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
    x:Class="EngineEditor.MainWindow"
    Title="Lithium Editor UI">


    <!-- All Styles for the A-XAML (like .CSS in html) -->
    <Window.Styles>

            <Style Selector="TextBlock.monospace">
                <Setter Property="FontFamily" Value="Consolas" />
            </Style>

            <Style Selector="Border.background">
                    <Setter Property="Background" Value="#191919" />
                    <Setter Property="CornerRadius" Value="10"       />
            </Style>

             <Style Selector="Button.entity">
                    <Setter Property="Margin"               Value="0"                   />
                    <Setter Property="Background"           Value="#474747"           />
                    <Setter Property="Foreground"           Value="#FDFDFD"           />
                    <Setter Property="CornerRadius"         Value="0.0"                 />
                    <Setter Property="RenderTransform"      Value="scale(0.9)" />
                    <Setter Property="Padding" Value="10, 0" />
                    <Setter Property="Width" Value="300" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Button Pressed -->
            <Style Selector="Button.entity:pressed">
                    <!-- Change background -->
                    <Setter Property="Background"           Value="#3A3A3A"           />
                    <!-- Change Text Color (Foreground) -->
                    <Setter Property="Foreground"           Value="#C2C2C2"           />
                    <Setter Property="RenderTransform"      Value="scale(0.9)" />
            </Style>

            <!-- Base Button Style -->
            <Style Selector="Button.top">
                    <!-- HTML margin vro -->
                    <Setter Property="Margin"      Value="0" />
                    <!-- Background COlor -->
                    <Setter Property="Background"           Value="White"           />
                    <!-- Text Color (Foreground) -->
                    <Setter Property="Foreground"           Value="Black"           />
                    <Setter Property="CornerRadius"         Value="4.0"                 />

                    <Setter Property="RenderTransform"      Value="scale(0.9)" />

                    <Setter Property="Padding" Value="0, 0" />

                    <Setter Property="Width" Value="80" />
                    <Setter Property="Height" Value="25" />
                    <Setter Property="FontSize" Value="17" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Button Pressed -->
            <Style Selector="Button.top:pressed">
                    <!-- Change background -->
                    <Setter Property="Background"           Value="#3A3A3A"           />
                    <!-- Change Text Color (Foreground) -->
                    <Setter Property="Foreground"           Value="#C2C2C2"           />
                    <!-- Change scale slightly to add reactivity (mild satisfaction) -->
                    <Setter Property="RenderTransform"      Value="scale(0.89)" />
            </Style>


            <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Tab Loot -->
             <Style Selector="TabControl">
                 <Setter Property="Background" Value="Transparent" />
                 <Setter Property="Padding"    Value="0" />
             </Style>
 
             <Style Selector="TabItem">
                 <Setter Property="FontSize"   Value="16" />
                 <Setter Property="Foreground" Value="#9A9A9A" />
                 <Setter Property="Padding"    Value="12,4" />
             </Style>
 
             <Style Selector="TabItem:selected">
                 <Setter Property="Foreground" Value="White" />
             </Style>
 
             <Style Selector="TabItem:pointerover">
                 <Setter Property="Foreground" Value="#DADADA" />
             </Style>

    </Window.Styles>


	<!-- Actual UI stuff not styles.. -->
    <Grid RowDefinitions="Auto,*" Background="#1B1B1B">

        <!-- Buttons at Top Row -->
        <StackPanel Grid.Row="0" Spacing="2" Orientation="Horizontal" Margin="8">
            <Button Content="Project" x:Name="TopProjectButton" Classes="top" />

        </StackPanel>

        <!-- Everythig below the top button 'bar' -->
        <Grid Grid.Row="1" Margin="10" ColumnDefinitions="300,5,*,5,360">

            <!-- Left Panel (Entity Hierarchy) -->
            <Border Grid.Column="0" Classes="background">
                <TabControl Margin="5">
                    <TabItem Header="Hierarchy">
                        <ScrollViewer Margin="3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="EntityList" Orientation="Vertical">
                                <Button Content="EntityNameHere" Classes="entity" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <!-- Center Panel -->
            <Grid Grid.Column="2" RowDefinitions="2*,5,*">

                <!-- Scene/Game View -->
                <Border Grid.Row="0" Classes="background">
                    <TabControl Margin="5">
                        <TabItem Header="Viewport">
                            <StackPanel>
                                <DockPanel Margin="10" LastChildFill="False">
                                    <TextBlock x:Name="FpsCounter" DockPanel.Dock="Right" VerticalAlignment="Center" Text="fps.." />

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button Content="Instance" x:Name="ViewportNew" Classes="top" />
                                        <Button Content="Play" x:Name="ViewportPlay" Classes="top" />
                                        <Button Content="Pause" x:Name="ViewportPause" Classes="top" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- Renderer output (totaly not waiting i promise...) -->
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1" Background="Transparent" />

                <!-- Bottom Center Assets/Console -->
                <Border Grid.Row="2" Classes="background">
                    <TabControl Margin="5">

                        <TabItem Header="Assets">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AssetsList" Margin="5">
                                    <TextBlock Text="asset loot" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Console">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ConsoleOutput" Margin="5">

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Background="Transparent" />

            <!-- Right Panel (Inspector) -->
            <Border Grid.Column="4" Classes="background">
                <TabControl Margin="5">
                    <TabItem Header="Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="InspectorContent" Margin="5">

                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
        
</Window>

